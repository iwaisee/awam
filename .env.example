# Neon Postgres — pooled connection string for application traffic.
# Get it with: neon link && neon env pull   (writes this file's real values)
# or copy it from the Neon console (Connection Details → pooled).
DATABASE_URL=

# Direct (unpooled) string — only needed for migrations/psql, not the app.
# DATABASE_URL_UNPOOLED=

# Cloudinary — report evidence image storage (Dashboard → Cloudinary → API Keys).
# Leave empty to keep storing evidence inline in the ledger (previous behavior).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin Console — HS256 signing secret for the sada_admin_token cookie.
# Generate with: openssl rand -base64 48   (production requires >= 32 chars)
ADMIN_JWT_SECRET=
